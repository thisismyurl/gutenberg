{
	"wpds-border": {
		"$type": "dimension",
		"radius": {
			"xs": {
				"$value": { "value": 1, "unit": "px" },
				"$description": "Extra small radius",
				"$extensions": {
					"mode": {
						"corner-radius-none": { "value": 0, "unit": "px" },
						"corner-radius-sm": { "value": 1, "unit": "px" },
						"corner-radius-md": { "value": 2, "unit": "px" },
						"corner-radius-lg": { "value": 3, "unit": "px" },
						"corner-radius-xl": { "value": 5, "unit": "px" },
						"corner-radius-2xl": { "value": 7, "unit": "px" }
					},
					"com.figma.scopes": [ "CORNER_RADIUS" ]
				}
			},
			"sm": {
				"$value": { "value": 2, "unit": "px" },
				"$description": "Small radius",
				"$extensions": {
					"mode": {
						"corner-radius-none": { "value": 0, "unit": "px" },
						"corner-radius-sm": { "value": 2, "unit": "px" },
						"corner-radius-md": { "value": 4, "unit": "px" },
						"corner-radius-lg": { "value": 6, "unit": "px" },
						"corner-radius-xl": { "value": 10, "unit": "px" },
						"corner-radius-2xl": { "value": 14, "unit": "px" }
					},
					"com.figma.scopes": [ "CORNER_RADIUS" ]
				}
			},
			"md": {
				"$value": { "value": 4, "unit": "px" },
				"$description": "Medium radius",
				"$extensions": {
					"mode": {
						"corner-radius-none": { "value": 0, "unit": "px" },
						"corner-radius-sm": { "value": 4, "unit": "px" },
						"corner-radius-md": { "value": 6, "unit": "px" },
						"corner-radius-lg": { "value": 8, "unit": "px" },
						"corner-radius-xl": { "value": 12, "unit": "px" },
						"corner-radius-2xl": { "value": 16, "unit": "px" }
					},
					"com.figma.scopes": [ "CORNER_RADIUS" ]
				}
			},
			"lg": {
				"$value": { "value": 8, "unit": "px" },
				"$description": "Large radius",
				"$extensions": {
					"mode": {
						"corner-radius-none": { "value": 0, "unit": "px" },
						"corner-radius-sm": { "value": 8, "unit": "px" },
						"corner-radius-md": { "value": 12, "unit": "px" },
						"corner-radius-lg": { "value": 16, "unit": "px" },
						"corner-radius-xl": { "value": 24, "unit": "px" },
						"corner-radius-2xl": { "value": 32, "unit": "px" }
					},
					"com.figma.scopes": [ "CORNER_RADIUS" ]
				}
			},
			"$extensions": {
				"com.figma.scopes": [ "CORNER_RADIUS" ]
			}
		},
		"width": {
			"xs": {
				"$value": { "value": 1, "unit": "px" },
				"$description": "Extra small width",
				"$extensions": {
					"com.figma.scopes": [ "STROKE_FLOAT" ]
				}
			},
			"sm": {
				"$value": { "value": 2, "unit": "px" },
				"$description": "Small width",
				"$extensions": {
					"com.figma.scopes": [ "STROKE_FLOAT" ]
				}
			},
			"md": {
				"$value": { "value": 4, "unit": "px" },
				"$description": "Medium width",
				"$extensions": {
					"com.figma.scopes": [ "STROKE_FLOAT" ]
				}
			},
			"lg": {
				"$value": { "value": 8, "unit": "px" },
				"$description": "Large width",
				"$extensions": {
					"com.figma.scopes": [ "STROKE_FLOAT" ]
				}
			},
			"focus": {
				"$value": { "value": 2, "unit": "px" },
				"$description": "Border width for focus ring",
				"$extensions": {
					"mode": {
						"high-dpi": { "value": 1.5, "unit": "px" }
					},
					"com.figma.scopes": [ "STROKE_FLOAT" ]
				}
			}
		}
	}
}
